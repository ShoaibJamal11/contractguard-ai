# ─── n8n Webhook ──────────────────────────────────────────────────────────────
# Production URL of your n8n Webhook node.
# If this is not set, the API route returns a mocked analysis response so the
# UI works out of the box during local development.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/contract-analyze

# Optional: sent as "Authorization: Bearer <secret>" on every webhook call.
# Set this to the value you configured in n8n's "Header Auth" credential.
N8N_WEBHOOK_SECRET=

