# ─── n8n Webhook ──────────────────────────────────────────────────────────────
# Production URL of your n8n Webhook node.
# If this is not set (or unreachable), the route automatically falls back to
# a direct Groq API call using GROQ_API_KEY below.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/contract-analyze

# Optional: sent as "Authorization: Bearer <secret>" on every webhook call.
# Set this to the value you configured in n8n's "Header Auth" credential.
N8N_WEBHOOK_SECRET=

# ─── Groq API (direct fallback) ───────────────────────────────────────────────
# Used when N8N_WEBHOOK_URL is missing or unreachable.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
